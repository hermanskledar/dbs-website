---
import Base from "../layouts/Base.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { members, site, upcomingBirthdays } from "../data/site";

const agenda = upcomingBirthdays();
const firstYear = Math.min(...members.map((member) => member.since));
const lastYear = Math.max(...members.map((member) => member.since));
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-inner">
			<p class="kicker">{site.kind} · {site.association} · sinds {site.foundedYear}</p>
			<h1>{site.name}</h1>
			<p class="hero-motto">
				{site.motto}
				<span>{site.mottoNl}</span>
			</p>
			<div class="hero-actions">
				<a class="btn btn-gold" href="/contact">Kom borrelen</a>
				<a class="btn btn-ghost" href="/huis">Bekijk het huis</a>
			</div>
		</div>
	</section>

	<section class="stats" aria-label="In het kort">
		<div class="wrap stats-grid">
			<div>
				<strong>{site.foundedYear}</strong>
				<span>Opgericht op 9 oktober</span>
			</div>
			<div>
				<strong>{site.houseName}</strong>
				<span>Dispuutshuis aan de Korvel</span>
			</div>
			<div>
				<strong>{members.length}</strong>
				<span>Actieve leden</span>
			</div>
			<div>
				<strong>Olof</strong>
				<span>Moedervereniging in Tilburg</span>
			</div>
		</div>
	</section>

	<section class="section" id="verhaal">
		<div class="wrap center-copy">
			<p class="kicker">Ons verhaal</p>
			<h2>De schuit vaart zijn eigen koers</h2>
			<p>
				Dispuut Die Blauwe Schuite is een herendispuut van het Tilburgs Studenten Corps St. Olof.
				Het dispuut is op 9 oktober 1942 opgericht en is daarmee een van de oudste van de vereniging.
			</p>
			<p>
				De schuit vaart altijd zijn eigen koers. Dat zie je terug in het doen en laten van de leden.
				De groep bestaat uit verschillende individuen, die door tradities en gebruiken een gezamenlijk
				doel nastreven en daarin broederschap vinden.
			</p>
			<p>
				Gebroederlijk gaan de leden deze periode aan en proberen zij er het meeste uit te halen, om
				daarna het werkende leven tegemoet te gaan. Door die lange geschiedenis is er een grote en
				trouwe achterban van oud-leden. Zij komen geregeld bijeen om de tradities en vieringen van het
				dispuut te vieren.
			</p>
		</div>
		<div class="wrap pillars">
			<article class="pillar">
				<h3>Die Blauwe Schuit</h3>
				<p>
					Leden komen uit verschillende lichtingen. Zo blijft het huis, de traditie en het bestuur
					doorlopen terwijl er elk jaar nieuwe mannen aanschuiven.
				</p>
			</article>
			<article class="pillar">
				<h3>Eigen huis</h3>
				<p>
					Op de Korvelseweg staat Enugu: acht kamers, een eettafel voor elke dag en een huisbar met
					tap. Vanuit daar fiets je in een paar minuten naar de sociëteit.
				</p>
			</article>
			<article class="pillar">
				<h3>84 jaar schuiters</h3>
				<p>
					Oud-Schuiters blijven terugkomen voor de vieringen die het dispuut rijk is. Een schuiter blijf je.  
				</p>
			</article>
		</div>
	</section>

	<section class="feature-band" aria-label="Verder kijken">
		<div class="wrap">
			<h2>Drie deuren naar de schuit</h2>
			<div class="cards">
				<a class="card" href="/bestuur">
					<img src="/images/hero.jpg" alt="Leden van Die Blauwe Schuite in het blauw" />
					<div>
						<h3>Bestuur</h3>
						<p>Vaermeester, journaelscrivère en gelaghmeester: het dagelijks bestuur, met de oude namen van het dispuut.</p>
						<span class="more">Naar het bestuur</span>
					</div>
				</a>
				<a class="card" href="/leden">
					<img src="/images/leden/fokke.jpg" alt="Portret van een lid van Die Blauwe Schuite" />
					<div>
						<h3>Leden</h3>
						<p>
							{members.length} leden, uit de lichtingen van {firstYear} tot en met {lastYear}. Individuen die samen één dispuut vormen.
						</p>
						<span class="more">Naar de leden</span>
					</div>
				</a>
				<a class="card" href="/huis">
					<img src="/images/huis-gevel.png" alt="De gevel van dispuutshuis Enugu aan de Korvelseweg" />
					<div>
						<h3>Huis Enugu</h3>
						<p>Een monumentaal pand uit 1906, met acht kamers en een zelfgebouwde bar. Ongeveer €400 per maand.</p>
						<span class="more">Naar het huis</span>
					</div>
				</a>
			</div>
		</div>
	</section>

	<section class="section section-paper">
		<div class="wrap quotes">
			<blockquote>
				<p>
					Een eigenzinnig dispuut. Een dispuut met een rijk verleden. Een dispuut van individuen die
					samen een geheel vormen.
				</p>
				<footer>Marcelle Hendrickx, wethouder Onderwijs, Tilburg</footer>
			</blockquote>
			<blockquote class="quote-aside">
				<p>Never forget: fill it up again. Once it hits your lips, it’s so good.</p>
				<footer>Frank the Tank</footer>
			</blockquote>
		</div>
	</section>

	<section class="section" id="agenda">
		<div class="wrap split">
			<div class="panel">
				<p class="kicker">Agenda</p>
				<h2>Verjaardagen</h2>
				<ul class="birthday-list" data-birthdays>
					{
						agenda.map((item) => (
							<li data-month={item.month} data-day={item.day}>
								<span>{item.name}</span>
								<time datetime={item.datetime}>{item.when}</time>
							</li>
						))
					}
				</ul>
			</div>
			<div class="panel">
				<p class="kicker">Langskomen</p>
				<h2>Borrelen op Enugu</h2>
				<p>
					Interesse in het huis of het dispuut? Kom een keer langs voor een biertje aan de bar en een
					borrel Blankenheym.
				</p>
				<p class="visit-address">
					{site.houseName}<br />
					{site.address.street}<br />
					{site.address.postcode} {site.address.city}
				</p>
				<p class="muted">Journaelscrivère {site.phoneName} · {site.phoneDisplay}</p>
				<p><a class="btn btn-navy" href="/contact">Neem contact op</a></p>
			</div>
		</div>
	</section>
</Base>

<script>
	import { nextBirthdayKey } from "../data/site";

	const list = document.querySelector<HTMLElement>("[data-birthdays]");
	if (list) {
		const items = [...list.children] as HTMLElement[];
		items.sort(
			(a, b) =>
				nextBirthdayKey(Number(a.dataset.month), Number(a.dataset.day)) -
				nextBirthdayKey(Number(b.dataset.month), Number(b.dataset.day)),
		);
		for (const item of items) list.append(item);
	}
</script>
