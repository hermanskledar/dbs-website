---
import Base from "../layouts/Base.astro";
import { addressLine, site } from "../data/site";
import { SITE_TITLE } from "../consts";
---

<Base title={SITE_TITLE} image="/images/terras.webp">
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Natuursteenbedrijf in Waalwijk</p>
			<h1>Ontdek onze passie voor het mooiste natuursteen.</h1>
			<p class="lead">
				In de werkplaats aan de Energieweg zagen en bewerken we steen op maat. Voor de keuken, de badkamer, de gevel en de tuin. De showroom ligt naast de machines.
			</p>
			<div class="hero-actions">
				<a class="button" href="/contact">Bezoek de showroom</a>
				<a class="button button-ghost" href={site.phoneHref}>{site.phoneDisplay}</a>
			</div>
			<dl class="hero-facts">
				<div>
					<dt>Doordeweeks</dt>
					<dd>7.30–17.30</dd>
				</div>
				<div>
					<dt>Zaterdag</dt>
					<dd>9.00–13.00</dd>
				</div>
				<div>
					<dt>Werkplaats</dt>
					<dd>Eigen zagerij en CNC</dd>
				</div>
			</dl>
		</div>
		<figure class="hero-photo">
			<img
				src="/images/terras.webp"
				width="900"
				height="1200"
				alt="Terras van Belgisch hardsteen, gelegd in verschillende maten."
				fetchpriority="high"
			/>
			<figcaption>Terras in Belgisch hardsteen</figcaption>
		</figure>
	</section>

	<div class="wrap">
		<ul class="stone-strip" aria-label="Materialen">
			<li>Marmer</li>
			<li>Graniet</li>
			<li>Kalksteen</li>
			<li>Leisteen</li>
			<li>Belgisch hardsteen</li>
			<li>Composiet</li>
		</ul>
	</div>

	<section class="doors" aria-label="Binnen en buiten">
		<a href="/binnen">
			<img src="/images/vloer.webp" alt="" width="1415" height="2000" />
			<span class="eyebrow">Binnen</span>
			<strong>Vloeren, bladen en schouwen</strong>
		</a>
		<a href="/buiten">
			<img src="/images/stoep.webp" alt="" width="1400" height="937" />
			<span class="eyebrow">Buiten</span>
			<strong>Dorpels, gevels en terrassen</strong>
		</a>
	</section>

	<section class="section wrap">
		<div class="section-head">
			<h2>Gemaakt aan de Energieweg</h2>
		</div>
		<p class="section-intro">
			Meten, zagen en schuren gebeurt in eigen huis. Naast het handwerk staat een 5-assige CNC, voor profielen die tot op de tekening moeten kloppen.
		</p>
		<div class="trio">
			<figure>
				<img src="/images/meten.webp" width="1400" height="937" alt="Een plaat natuursteen wordt opgemeten in de werkplaats." loading="lazy" />
				<figcaption><strong>Meten</strong> Elke plaat wordt opgenomen voor hij de zaag in gaat.</figcaption>
			</figure>
			<figure>
				<img src="/images/cnc.webp" width="2000" height="1339" alt="Zaagmachine die een plaat natuursteen op maat zaagt." loading="lazy" />
				<figcaption><strong>Zagen</strong> Bladen, dorpels en neuten komen van de eigen zaag.</figcaption>
			</figure>
			<figure>
				<img src="/images/schuren.webp" width="2000" height="1339" alt="Een hardstenen dorpel wordt geschuurd in de werkplaats." loading="lazy" />
				<figcaption><strong>Afwerken</strong> Schuren, frijnen of polijsten, afhankelijk van de steen.</figcaption>
			</figure>
		</div>
	</section>

	<section class="section wrap" style="padding-top: 0">
		<div class="section-head">
			<h2>Uit de werkplaats</h2>
		</div>
		<div class="mosaic">
			<a class="tile" href="/binnen#vloertegels">
				<img src="/images/vloer.webp" alt="" width="1415" height="2000" loading="lazy" />
				<span>Vloertegels</span>
			</a>
			<a class="tile" href="/binnen#keukenbladen">
				<img src="/images/keukenblad.webp" alt="" width="2000" height="1339" loading="lazy" />
				<span>Keukenbladen</span>
			</a>
			<a class="tile" href="/buiten#terrastegels">
				<img src="/images/terras.webp" alt="" width="900" height="1200" loading="lazy" />
				<span>Terrassen</span>
			</a>
			<a class="tile" href="/buiten#trappen">
				<img src="/images/stoep.webp" alt="" width="1400" height="937" loading="lazy" />
				<span>Stoepen</span>
			</a>
			<a class="tile" href="/binnen#schouwen">
				<img src="/images/schouw.webp" alt="" width="960" height="720" loading="lazy" />
				<span>Schouwen</span>
			</a>
		</div>
	</section>

	<section class="section wrap" style="padding-top: 0">
		<div class="section-head">
			<h2>De steen zelf</h2>
			<a href="/materialen">Alle materialen</a>
		</div>
		<p class="section-intro">
			Een greep uit de showroom. Het assortiment wisselt; bel even als u een bepaalde soort zoekt.
		</p>
		<ul class="swatches">
			<li>
				<a href="/materialen#marmer">
					<figure>
						<img src="/images/stenen/bianco-carrara-c.webp" width="300" height="200" alt="" />
						<figcaption>Bianco Carrara C</figcaption>
					</figure>
				</a>
			</li>
			<li>
				<a href="/materialen#graniet">
					<figure>
						<img src="/images/stenen/baltic-brown.webp" width="300" height="200" alt="" />
						<figcaption>Baltic Brown</figcaption>
					</figure>
				</a>
			</li>
			<li>
				<a href="/materialen#kalksteen">
					<figure>
						<img src="/images/stenen/massangis-clair.webp" width="300" height="200" alt="" />
						<figcaption>Massangis Clair</figcaption>
					</figure>
				</a>
			</li>
			<li>
				<a href="/materialen#leisteen">
					<figure>
						<img src="/images/stenen/montauk-black.webp" width="300" height="201" alt="" />
						<figcaption>Montauk Black</figcaption>
					</figure>
				</a>
			</li>
		</ul>
	</section>

	<section class="band">
		<div class="band-copy">
			<p class="eyebrow">Belgisch hardsteen</p>
			<h2>De steen van de gevel.</h2>
			<p>
				Dorpels, spekbanden, plinten, sluitstenen en afdekkers. In de klassieke bewerkingen, en in de bijzondere afwerkingen die u in de showroom kunt vergelijken.
			</p>
			<a class="button" href="/materialen#hardsteen">Bekijk de afwerkingen</a>
		</div>
		<img
			src="/images/muur.webp"
			width="1400"
			height="935"
			alt="Toegangshek met muurafdekkers en paalafdekkers van Belgisch hardsteen."
			loading="lazy"
		/>
	</section>

	<section class="visit">
		<img
			src="/images/pand.webp"
			width="2000"
			height="1336"
			alt="Het pand van Skledar Natuursteen aan de Energieweg in Waalwijk."
			loading="lazy"
		/>
		<div class="visit-copy">
			<p class="eyebrow">Showroom</p>
			<h2>Kom de steen bekijken.</h2>
			<p>
				{addressLine}. De werkplaats is open: u ziet hoe een blad of een dorpel wordt gemaakt. In de winkel liggen ook
				<a href="/onderhoud">onderhoudsmiddelen</a> en diamantgereedschap.
			</p>
			<address>
				{site.hours[0].days}: {site.hours[0].time}<br />
				{site.hours[1].days}: {site.hours[1].time}<br />
				{site.hours[2].days}: {site.hours[2].time}
			</address>
			<a class="button" href="/contact">Contact en route</a>
		</div>
	</section>
</Base>
