---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import { initials, members } from "../data/site";
---

<Base
	title="Leden"
	description="De actieve leden van herendispuut Die Blauwe Schuite, uit de lichtingen 2018 tot en met 2025."
>
	<PageIntro
		kicker="De bemanning"
		title="Leden"
		lede="Een dispuut is een verticaal verband: mannen uit verschillende jaren, één huis en één koers. Bij elke naam staat de lichting waarin hij lid is geworden."
	/>

	<section class="section section-paper">
		<div class="wrap">
			<ul class="member-grid" style="list-style: none; margin: 0; padding: 0;">
				{
					members.map((member) => (
						<li class="person">
							<div class="portrait">
								{member.photo ? (
									<img
										src={member.photo}
										alt={`Portret van ${member.name}`}
										style={`object-position: ${member.focus}`}
									/>
								) : (
									<span class="monogram" aria-hidden="true">
										{initials(member.name)}
									</span>
								)}
							</div>
							<div class="person-body">
								<h2>{member.name}</h2>
								<p>Lid sinds {member.since}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>
