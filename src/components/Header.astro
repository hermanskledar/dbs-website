---
import Seal from "./Seal.astro";
import { nav, site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="utility">
	<div class="wrap utility-inner">
		<p>
			{site.kind} van <a href={site.associationUrl} target="_blank" rel="noopener noreferrer">{site.association}</a>
			<span aria-hidden="true"> · </span>
			<span>Tilburg</span>
		</p>
		<p class="utility-links">
			<a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">@{site.instagram}</a>
			<a href={`mailto:${site.email}`}>{site.email}</a>
		</p>
	</div>
</div>

<header class="site-header">
	<div class="wrap header-inner">
		<a class="brand" href="/" aria-label={`${site.name}, naar de homepagina`}>
			<span class="brand-seal"><Seal compact /></span>
			<span class="brand-text">
				<span class="brand-name">{site.name}</span>
				<span class="brand-sub">{site.motto}</span>
			</span>
		</a>

		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu">
			<span class="nav-toggle-bars" aria-hidden="true"></span>
			<span class="nav-toggle-label">Menu</span>
		</button>

		<nav id="menu" class="site-nav" aria-label="Hoofdmenu">
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={item.href} aria-current={path === item.href ? "page" : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="btn btn-gold" href="/contact">Kom borrelen</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector(".nav-toggle");
	const nav = document.querySelector(".site-nav");

	const setOpen = (open: boolean) => {
		nav?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", String(open));
	};

	toggle?.addEventListener("click", () => {
		setOpen(toggle.getAttribute("aria-expanded") !== "true");
	});

	nav?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setOpen(false));
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setOpen(false);
	});
</script>
