---
import Seal from "./Seal.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap footer-grid">
		<div class="footer-brand">
			<span class="footer-seal"><Seal /></span>
			<div>
				<p class="footer-name">{site.name}</p>
				<p class="footer-motto">{site.motto}</p>
				<p class="footer-note">
					{site.kind}, opgericht op {site.foundedLabel}. Gelieerd aan
					<a href={site.associationUrl} target="_blank" rel="noopener noreferrer">{site.association}</a>.
				</p>
			</div>
		</div>

		<nav aria-label="Footer">
			<p class="footer-label">Op deze site</p>
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<p class="footer-label">Dispuutshuis {site.houseName}</p>
			<address>
				{site.address.street}<br />
				{site.address.postcode} {site.address.city}
			</address>
			<ul class="footer-contact">
				<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				<li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
				<li><a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram @{site.instagram}</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap footer-bottom">
		<p>© {year} Dispuut {site.name}</p>
		<p>De schuit vaart altijd zijn eigen koers.</p>
	</div>
</footer>
