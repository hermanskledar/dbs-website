---
import { addressLine, nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap footer-grid">
		<div>
			<p class="footer-name">Skledar Natuursteen</p>
			<p>Showroom en werkplaats voor natuursteen op maat.</p>
		</div>
		<div>
			<p class="footer-label">Bezoek</p>
			<p>
				{addressLine}<br />
				<a href={site.phoneHref}>{site.phoneDisplay}</a><br />
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</p>
			<p>
				{site.hours[0].short} {site.hours[0].time}<br />
				{site.hours[1].short} {site.hours[1].time}
			</p>
		</div>
		<div>
			<p class="footer-label">Op de site</p>
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
				<li><a href="/privacy">Privacy</a></li>
			</ul>
		</div>
	</div>
	<div class="wrap footer-base">
		<p>© {year} {site.legalName}</p>
		<p>KVK {site.kvk} · BTW {site.btw}</p>
	</div>
</footer>
