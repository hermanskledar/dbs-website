---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<svg
	class:list={["seal", { "seal-compact": compact }]}
	viewBox="0 0 200 200"
	role="img"
	aria-hidden="true"
>
	<circle class="seal-ring" cx="100" cy="100" r="94" />
	<circle class="seal-ring seal-ring-inner" cx="100" cy="100" r="82" />
	{
		!compact && (
			<>
				<defs>
					<path id="seal-top" d="M28,100 A72,72 0 0 1 172,100" />
					<path id="seal-bottom" d="M172,108 A72,72 0 0 1 28,108" />
				</defs>
				<text class="seal-text">
					<textPath href="#seal-top" startOffset="50%" text-anchor="middle">
						DIE BLAUWE SCHUITE
					</textPath>
				</text>
				<text class="seal-text seal-text-bottom">
					<textPath href="#seal-bottom" startOffset="50%" text-anchor="middle">
						TILBURG · 1942
					</textPath>
				</text>
			</>
		)
	}
	<g class="seal-ship" fill="currentColor">
		<path d="M46 124h108l-12 16c-22 10-62 10-84 0z" />
		<path d="M99 122V58h3v64z" />
		<path d="M102 64c22 8 36 28 40 50h-40z" />
		<path d="M99 66c-8 14-10 30-8 46h8z" opacity="0.9" />
		<path d="M102 56l16 8-16 6z" />
		<path
			d="M34 146c8-6 16-6 24 0s16 6 24 0 16-6 24 0 16 6 24 0 16-6 24 0 16 6 12 4"
			fill="none"
			stroke="currentColor"
			stroke-width="3"
			stroke-linecap="round"
		/>
	</g>
</svg>

<style>
	.seal {
		display: block;
		width: 100%;
		height: auto;
		color: currentColor;
	}

	.seal-ring {
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
	}

	.seal-ring-inner {
		stroke-width: 1;
	}

	.seal-text {
		fill: currentColor;
		font-family: Outfit, "Avenir Next", "Segoe UI", sans-serif;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.seal-text-bottom {
		font-size: 13px;
		letter-spacing: 0.18em;
	}

	.seal-compact .seal-ship {
		transform: translateY(-6px);
	}
</style>
