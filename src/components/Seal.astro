---
interface Props {
	/** "ink" is the black seal for light backgrounds. "light" keeps the white original for the navy footer. */
	tone?: "ink" | "light";
}

const { tone = "ink" } = Astro.props;
---

<img
	class:list={["seal", { "seal-ink": tone === "ink" }]}
	src="/images/logo.png"
	alt=""
	width="100"
	height="100"
/>

<style>
	.seal {
		display: block;
		width: 100%;
		height: auto;
	}

	.seal-ink {
		filter: invert(1);
	}
</style>
